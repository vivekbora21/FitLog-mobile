# ==============================================================================
# FitLog Mobile Environment Configuration
# ==============================================================================
# In Expo, variables prefixed with EXPO_PUBLIC_ are bundled into the JavaScript
# code and available on client devices via process.env.EXPO_PUBLIC_*
#
# Choose the appropriate backend URL based on your development environment:
#
# 1. Android Emulator:
#    Use 10.0.2.2 (special alias to host machine loopback interface)
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
#
# 2. iOS Simulator:
#    Use localhost (shares host network stack)
#    EXPO_PUBLIC_API_URL=http://localhost:8000/api
#
# 3. Physical Mobile Device (Expo Go / Development Build):
#    Use your computer's local Wi-Fi IP address (e.g. 192.168.1.100)
#    EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api
#
# 4. Production API:
#    EXPO_PUBLIC_API_URL=https://api.fitlog.example.com/api
# ==============================================================================

EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
